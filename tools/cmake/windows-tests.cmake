include(CTest)
if(NOT BUILD_TESTING)
  return()
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/test-data")
nexus_add_gpu_policy_tests()
foreach(case live_worker_config primary_vulkan_policy startup_readiness)
  add_executable(nexus-${case}-test "tests/${case}_test.cpp")
  target_include_directories(nexus-${case}-test PRIVATE include)
  target_link_libraries(nexus-${case}-test PRIVATE Threads::Threads)
  add_test(NAME ${case}_policy COMMAND nexus-${case}-test)
endforeach()
foreach(case pipeline live_job_queue proof_transport merkle_prefetch gguf_reader consensus)
  add_executable(nexus-${case}-test "tests/${case}_test.cpp")
  target_link_libraries(nexus-${case}-test PRIVATE nexus_model)
endforeach()
add_test(NAME canonical_pipeline COMMAND nexus-pipeline-test)
add_test(NAME job_freshness COMMAND nexus-live_job_queue-test)
add_test(NAME proof_transport COMMAND nexus-proof_transport-test)
add_test(NAME merkle_paths COMMAND nexus-merkle_prefetch-test "${CMAKE_BINARY_DIR}/test-data/merkle")
add_test(NAME gguf_bounds COMMAND nexus-gguf_reader-test "${CMAKE_BINARY_DIR}/test-data/gguf")
add_executable(nexus-platform-file-test tests/platform_file_test.cpp)
target_link_libraries(nexus-platform-file-test PRIVATE nexus_model advapi32)
add_test(NAME native_file_reads COMMAND nexus-platform-file-test "${CMAKE_BINARY_DIR}/test-data/files")

add_executable(nexus-windows-process-test tests/windows_process_test.cpp)
target_include_directories(nexus-windows-process-test PRIVATE include)
target_link_libraries(nexus-windows-process-test PRIVATE advapi32)
add_test(NAME native_verifier_transport COMMAND nexus-windows-process-test)
set_tests_properties(native_verifier_transport PROPERTIES TIMEOUT 15)
