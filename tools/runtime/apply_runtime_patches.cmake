cmake_minimum_required(VERSION 3.25)
if(NOT IS_DIRECTORY "${NEXUS_LLAMA_SOURCE}" OR NOT EXISTS "${NEXUS_RUNTIME_MANIFEST}")
  message(FATAL_ERROR "Runtime source directory and patch manifest are required")
endif()
find_package(Git REQUIRED)
get_filename_component(NEXUS_LLAMA_SOURCE "${NEXUS_LLAMA_SOURCE}" REALPATH)
get_filename_component(nexus_source_parent "${NEXUS_LLAMA_SOURCE}" DIRECTORY)
if(NOT NEXUS_PATCH_ROOT)
  get_filename_component(NEXUS_PATCH_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
get_filename_component(NEXUS_PATCH_ROOT "${NEXUS_PATCH_ROOT}" REALPATH)
file(READ "${NEXUS_RUNTIME_MANIFEST}" nexus_manifest)
string(JSON nexus_schema GET "${nexus_manifest}" schema_version)
if(NOT nexus_schema EQUAL 1)
  message(FATAL_ERROR "Unsupported runtime patch manifest schema")
endif()
# Git must not discover a parent checkout or inherit caller-selected index/worktree paths.
set(nexus_apply_command "${CMAKE_COMMAND}" -E env
  --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
  "GIT_CEILING_DIRECTORIES=${nexus_source_parent}"
  "${GIT_EXECUTABLE}" -c core.autocrlf=false -c core.eol=lf
  -C "${NEXUS_LLAMA_SOURCE}" apply)
function(nexus_safe_relative name)
  if(IS_ABSOLUTE "${name}" OR "${name}" MATCHES "(^|/)\\.\\.(/|$)" OR "${name}" MATCHES "\\\\")
    message(FATAL_ERROR "Invalid runtime manifest path: ${name}")
  endif()
endfunction()
function(nexus_checked_input path digest)
  nexus_safe_relative("${path}")
  set(candidate "${NEXUS_PATCH_ROOT}/${path}")
  if(NOT EXISTS "${candidate}" OR IS_DIRECTORY "${candidate}" OR IS_SYMLINK "${candidate}")
    message(FATAL_ERROR "Runtime input missing or unsafe: ${path}")
  endif()
  file(SHA256 "${candidate}" actual)
  if(NOT actual STREQUAL digest)
    message(FATAL_ERROR "Runtime input SHA-256 mismatch: ${path}")
  endif()
endfunction()
string(JSON nexus_wrapper_path GET "${nexus_manifest}" wrapper path)
string(JSON nexus_wrapper_hash GET "${nexus_manifest}" wrapper sha256)
nexus_checked_input("${nexus_wrapper_path}" "${nexus_wrapper_hash}")
string(JSON nexus_patch_count LENGTH "${nexus_manifest}" patches)
string(JSON nexus_stage_count LENGTH "${nexus_manifest}" stages)
math(EXPR nexus_expected_stages "${nexus_patch_count}+1")
if(nexus_patch_count LESS 1 OR NOT nexus_stage_count EQUAL nexus_expected_stages)
  message(FATAL_ERROR "Runtime manifest must name an ordered patch chain and all its stages")
endif()
math(EXPR nexus_last_patch "${nexus_patch_count}-1")
foreach(i RANGE 0 ${nexus_last_patch})
  string(JSON path GET "${nexus_manifest}" patches ${i} path)
  string(JSON digest GET "${nexus_manifest}" patches ${i} sha256)
  nexus_checked_input("${path}" "${digest}")
endforeach()
function(nexus_stage_matches index output)
  string(JSON files GET "${nexus_manifest}" stages ${index} files)
  string(JSON count LENGTH "${files}")
  if(count LESS 1)
    message(FATAL_ERROR "Empty runtime source stage")
  endif()
  math(EXPR last "${count}-1")
  foreach(j RANGE 0 ${last})
    string(JSON name MEMBER "${files}" ${j})
    nexus_safe_relative("${name}")
    set(candidate "${NEXUS_LLAMA_SOURCE}/${name}")
    string(JSON kind TYPE "${files}" "${name}")
    if(kind STREQUAL "NULL")
      if(EXISTS "${candidate}" OR IS_SYMLINK "${candidate}")
        set(${output} FALSE PARENT_SCOPE)
        return()
      endif()
    else()
      if(NOT kind STREQUAL "STRING" OR NOT EXISTS "${candidate}" OR IS_DIRECTORY "${candidate}" OR IS_SYMLINK "${candidate}")
        set(${output} FALSE PARENT_SCOPE)
        return()
      endif()
      string(JSON digest GET "${files}" "${name}")
      file(SHA256 "${candidate}" actual)
      if(NOT actual STREQUAL digest)
        set(${output} FALSE PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  set(${output} TRUE PARENT_SCOPE)
endfunction()
nexus_stage_matches(${nexus_patch_count} verified)
if(verified)
  message(STATUS "ABI9 runtime patch chain verified (${nexus_patch_count} patches)")
  return()
endif()
if(NEXUS_VERIFY_ONLY)
  message(FATAL_ERROR "Runtime patch chain is missing, modified or incomplete")
endif()
set(nexus_current_stage -1)
foreach(i RANGE 0 ${nexus_last_patch})
  nexus_stage_matches(${i} matches)
  if(matches)
    set(nexus_current_stage ${i})
  endif()
endforeach()
if(nexus_current_stage LESS 0)
  message(FATAL_ERROR "Runtime source does not match a known pristine/patched stage; left unchanged")
endif()
foreach(i RANGE ${nexus_current_stage} ${nexus_last_patch})
  string(JSON path GET "${nexus_manifest}" patches ${i} path)
  execute_process(COMMAND ${nexus_apply_command} --check "${NEXUS_PATCH_ROOT}/${path}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE detail)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Runtime patch check failed for ${path}: ${detail}")
  endif()
  execute_process(COMMAND ${nexus_apply_command} "${NEXUS_PATCH_ROOT}/${path}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE detail)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Runtime patch failed for ${path}: ${detail}")
  endif()
  math(EXPR next_stage "${i}+1")
  nexus_stage_matches(${next_stage} matches)
  if(NOT matches)
    message(FATAL_ERROR "Runtime patch stage ${next_stage} is incomplete; refusing to build")
  endif()
endforeach()
message(STATUS "ABI9 runtime patch chain applied and all source hashes verified")
